{
  "appID": "com.SINEM.RegistroPagos",

  "files": [
    "dist/electron/**",
    "dist/react/**"
  ],

  "directories": {
    "output": "release-builds"
  },

  "extraResources": [
    {
      "from": "/electron/assets/",
      "to": "/assets", 
      "filter": [
        "**/*"
      ]
    }
  ],

  "win": {
    "target": [
      "portable",
      "msi"
    ]
  }
}
